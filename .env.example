# Supabase Configuration
# Prefer new Dashboard keys (API Keys tab). Legacy JWT anon/service_role still work as fallbacks.
# https://supabase.com/docs/guides/api/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy (optional if using publishable/secret above):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Do not set NODE_ENV in .env files. Next.js sets it for next dev / next build. A committed NODE_ENV=development
# OPENAI_API_KEY=sk-...
# Optional: OPENAI_RISK_MODEL=gpt-4o-mini
# Optional: OPENAI_ICD_MODEL=gpt-4o-mini  (POST /api/encounters/:id/icd-suggestions)
# Optional: OPENAI_I693_MODEL=gpt-4o-mini
# Optional: OPENAI_I693_SUPPORTING_DOCS_MODEL=gpt-4o-mini

# AWS Textract (server-only): I-693 supporting-document OCR
# AWS_REGION=us-east-1
# Optional if not using an IAM role / default AWS credential chain:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional: AWS_TEXTRACT_REGION=us-east-1

# Optional: US address autocomplete (patient edit, intake-style lookup)
# SMARTY_AUTH_ID=
# SMARTY_AUTH_TOKEN=
# MAPBOX_ACCESS_TOKEN=

# Daily.co Configuration (server-only key — do not use NEXT_PUBLIC_DAILY_API_KEY in production)
DAILY_API_KEY=your_daily_api_key
NEXT_PUBLIC_DAILY_DOMAIN=your_daily_domain

# Admin Configuration
ADMIN_SIGNUP_PIN=your_admin_pin

# Cloudflare Turnstile (CAPTCHA on login only). Inactive until TURNSTILE_SECRET_KEY is set.
# https://dash.cloudflare.com/?to=/:account/turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Sentry Configuration (Optional)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Complete SOAP Notes API (Optional - triggers AI SOAP completion after vitals are saved)
NEXT_PUBLIC_SOAP_NOTES_API_URL=https://mcm-soapnotes-production.up.railway.app/api/soap/complete-soapnotes

# Resend (server-only): email prescriptions to pharmacy after save
# Sign up at https://resend.com and verify your sending domain (e.g. myclinicmd.com).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From address must use your verified domain:
# RESEND_FROM_EMAIL=prescriptions@yourdomain.com
# RESEND_FROM_NAME=MyClinicMD

# One-time staging → production data sync (scripts/sync-staging-to-production.mjs)
# STAGING_URL=https://kxtbfmlatysaxjzppmti.supabase.co
# STAGING_SECRET_KEY=sb_secret_...
# PROD_URL=https://bssjlpqdgmtgaxvadwdh.supabase.co
# PROD_SECRET_KEY=sb_secret_...

# Do not set NODE_ENV in .env files.
