# development | staging | production
APP_ENV=development


NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# VonLinkage (video microservice) — server-side only, never expose the API key to the client
VONLINKAGE_API_BASE_URL=http://localhost:3000
VONLINKAGE_API_KEY=vlk_...


OPENAI_API_KEY=sk-...

# I-693 TB report analysis. ANTHROPIC_TB_MODEL is optional (defaults to claude-opus-5).
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_TB_MODEL=claude-opus-5


NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn


AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_NAME=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

SMARTY_AUTH_ID=xxxxxxxx
SMARTY_AUTH_TOKEN=xxxxxxxx
MAPBOX_ACCESS_TOKEN=xxxxxxx

NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

BETTERSTACK_SOURCE_TOKEN=xxxxxxxx
BETTERSTACK_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/xxxxxxxx

# Site-wide maintenance ticker. Unset/'false' = hidden, 'true' = default message,
# any other string = that custom message shown in the banner.
# NEXT_PUBLIC_MAINTENANCE_TICKER=true
