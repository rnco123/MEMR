# Supabase Configuration
# Prefer new Dashboard keys (API Keys tab). Legacy JWT anon/service_role still work as fallbacks.
# https://supabase.com/docs/guides/api/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy (optional if using publishable/secret above):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Secondary Supabase project (optional)
# Use these when syncing or proxying data to another Supabase project.
# We do NOT use external auth/session; this is table-level access only.
# Final Review pre-sales dropdowns and GET /api/mcm/catalog read categories/products from this project (MCM).
EXTERNAL_SUPABASE_URL=https://your-other-project.supabase.co
EXTERNAL_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
EXTERNAL_SUPABASE_SECRET_KEY=sb_secret_...
# Legacy optional fallback:
# EXTERNAL_SUPABASE_ANON_KEY=
# EXTERNAL_SUPABASE_SERVICE_ROLE_KEY=
# Optional safety allowlist (comma-separated). Empty = deny all on POST /api/external-supabase.
# All tables MEMR uses on the external (MCM) project:
EXTERNAL_SUPABASE_ALLOWED_TABLES=categories,category_memr,products,product_memr,encounter,pre_sales,Appoinments,allpatients,intake_form,tenants,Locations
# Write mode for admin proxy only (default off). MCM sync / location sync bypass this flag.
# EXTERNAL_SUPABASE_ALLOW_WRITE=false
# Optional per-table column allowlists for proxy reads, e.g.:
# EXTERNAL_SUPABASE_COLUMNS_products=product_id,product_name,category_id,archived

# OpenAI (server-only): nurse risk alerts from intake + SOAP + vitals
# OPENAI_API_KEY=sk-...
# Optional: OPENAI_RISK_MODEL=gpt-4o-mini
# Optional: OPENAI_ICD_MODEL=gpt-4o-mini  (POST /api/encounters/:id/icd-suggestions)
# Optional: OPENAI_I693_MODEL=gpt-4o-mini
# Optional: OPENAI_I693_SUPPORTING_DOCS_MODEL=gpt-4o-mini

# AWS Textract (server-only): I-693 supporting-document OCR
# AWS_REGION=us-east-1
# Optional if not using an IAM role / default AWS credential chain:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional: AWS_TEXTRACT_REGION=us-east-1

# Daily.co Configuration (server-only key — do not use NEXT_PUBLIC_DAILY_API_KEY in production)
DAILY_API_KEY=your_daily_api_key
NEXT_PUBLIC_DAILY_DOMAIN=your_daily_domain

# Admin Configuration
ADMIN_SIGNUP_PIN=your_admin_pin

# Sentry Configuration (Optional)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Complete SOAP Notes API (Optional - triggers AI SOAP completion after vitals are saved)
NEXT_PUBLIC_SOAP_NOTES_API_URL=https://mcm-soapnotes-production.up.railway.app/api/soap/complete-soapnotes

# Resend (server-only): email prescriptions to pharmacy after save
# Sign up at https://resend.com and verify your sending domain (e.g. myclinicmd.com).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From address must use your verified domain:
# RESEND_FROM_EMAIL=prescriptions@yourdomain.com
# RESEND_FROM_NAME=MyClinicMD

# Do not set NODE_ENV in .env files. Next.js sets it for next dev / next build. A committed NODE_ENV=development
# breaks next build (mixed runtimes, prerender useContext errors). On Railway, do not set NODE_ENV=development for the service.
