# Do not set NODE_ENV in .env files. Next.js sets it for next dev / next build.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

DAILY_API_KEY=your_daily_api_key
NEXT_PUBLIC_DAILY_DOMAIN=your_daily_domain


OPENAI_API_KEY=sk-...


NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn


NEXT_PUBLIC_SOAP_NOTES_API_URL=https://mcm-soapnotes-production.up.railway.app/api/soap/complete-soapnotes


AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=prescriptions@yourdomain.com
RESEND_FROM_NAME=MyClinicMD


NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

SMARTY_AUTH_ID=xxxxxxxx
SMARTY_AUTH_TOKEN=xxxxxxxx
MAPBOX_ACCESS_TOKEN=xxxxxxx

