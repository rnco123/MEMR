APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# --- VonLinkage (LiveKit-backed telemedicine; the platform the patient app is on) ---
# Base URL of the VonLinkage API, no trailing slash.
VONLINKAGE_BASE_URL=
# Origin the browser opens its LiveKit WebSocket to, e.g. wss://livekit.example.com.
# This is the realtime host, NOT the API host above. Build-time only: it is
# baked into the Content-Security-Policy, and the call is blocked without it.
VONLINKAGE_LIVEKIT_ORIGIN=
# Tenant API key (vlk_...). SERVER-ONLY — never prefix this NEXT_PUBLIC_.
# It mints join tokens for any identity and role in this tenant's rooms, and
# it does not expire; it is revoked. Must be issued under the SAME VonLinkage
# tenant as the patient app's own key, or doctor and patient land in
# different rooms despite sharing a room name.
VONLINKAGE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_TB_MODEL=
NEXT_PUBLIC_SENTRY_DSN=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_HEARTBEAT_URL=
NEXT_PUBLIC_MAINTENANCE_TICKER=
