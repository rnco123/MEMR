{
    "name": "myclinicmd",
    "private": true,
    "description": "Modern video conferencing application built with Next.js, Supabase, and Daily.co.",
    "version": "1.0.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "lint:fix": "next lint --fix",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\""
    },
    "dependencies": {
        "@daily-co/daily-js": "^0.85.0",
        "@sentry/nextjs": "^10.38.0",
        "@supabase/ssr": "^0.8.0",
        "i": "^0.3.7",
        "lru-cache": "^10.1.0",
        "next": "^14.2.35",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.1.5",
        "@testing-library/react": "^14.1.2",
        "@testing-library/user-event": "^14.5.1",
        "@types/jest": "^29.5.11",
        "@types/node": "25.0.6",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "autoprefixer": "^10.4.23",
        "eslint": "^8.56.0",
        "eslint-config-next": "14.2.5",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "postcss": "^8.5.6",
        "prettier": "^3.2.4",
        "tailwindcss": "^3.4.19",
        "ts-jest": "^29.1.1",
        "typescript": "5.9.3"
    }
}
