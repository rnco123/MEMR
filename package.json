{
  "name": "myclinicmd",
  "private": true,
  "description": "MyclinicdMD Advanced EMR and Telemedicine Platform",
  "version": "3.3.0",
  "scripts": {
    "dev": "cross-env APP_ENV=development next dev",
    "dev:clean": "node scripts/clean-next.cjs --stop-dev && cross-env APP_ENV=development next dev",
    "build": "cross-env NODE_ENV=production next build",
    "build:clean": "node scripts/clean-next.cjs --stop-dev && cross-env NODE_ENV=production next build",
    "start": "node scripts/next-start.cjs",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "cross-env APP_ENV=development jest",
    "test:watch": "cross-env APP_ENV=development jest --watch",
    "test:coverage": "cross-env APP_ENV=development jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "seed:immigration": "node scripts/seed-immigration-sample.cjs",
    "seed:immigration:demo": "node scripts/seed-immigration-kanban-demo.cjs",
    "seed:compliance": "node scripts/seed-compliance-reviews.cjs",
    "seed:compliance:resync": "node scripts/seed-compliance-reviews.cjs --resync",
    "seed:avatars": "node scripts/seed-staff-avatars.cjs",
    "test:i693-pdf": "tsx scripts/test-i693-pdf-fill.mjs",
    "test:i693-export": "tsx scripts/test-i693-export.mjs",
    "test:i693-acroform": "tsx scripts/test-i693-acroform-fill.mjs",
    "audit:i693-registry": "tsx scripts/audit-i693-registry.mjs",
    "generate:i693-pdf-registry": "tsx scripts/generate-i693-pdf-field-registry.mjs",
    "generate:i693-checkbox-export-map": "tsx scripts/generate-checkbox-export-map.mjs",
    "test:i693-pdf-fields": "tsx scripts/test-i693-pdf-fields.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.67",
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-textract": "^3.1060.0",
    "@daily-co/daily-js": "^0.83.1",
    "@logtail/node": "^0.5.8",
    "@sentry/nextjs": "^10.38.0",
    "@supabase/ssr": "^0.8.0",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "ai": "^6.0.195",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "lottie-react": "^2.4.1",
    "lru-cache": "^10.1.0",
    "mupdf": "^1.27.0",
    "next": "^14.2.35",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "posthog-js": "^1.395.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "tsx": "^4.22.3",
    "zipcodes": "^8.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/node": "25.0.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/zipcodes": "^8.0.5",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "postgres": "^3.4.9",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.1.1",
    "typescript": "5.9.3"
  }
}
